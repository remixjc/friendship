PORT=3000
TZ=Asia/Shanghai
# 如果通过 HTTPS 反向代理部署，请设为 true，并配置 APP_ORIGIN。
COOKIE_SECURE=false
# 浏览器访问的准确地址，例如 https://attendance.example.com；留空时校验当前 Host。
APP_ORIGIN=
# 可选：32 字节加密密钥的 64 位十六进制字符串。
# 留空时首次启动自动生成到数据卷 secrets.key，之后不要删除或替换。
ENCRYPTION_KEY=
# 可选：仅用于自动部署时创建首个管理员；两项必须同时提供。
# 不设置时，在首次访问网页时创建管理员。
ADMIN_USERNAME=
ADMIN_PASSWORD=
